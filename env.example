# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
#
#   cp env.example .env.local     ← y completar con los valores reales
#
# .env.local NUNCA se commitea ni se comparte por chat.
# (El archivo se llama env.example sin punto a propósito: los archivos
#  .env* están bloqueados por las reglas de permisos del entorno.)
# ─────────────────────────────────────────────────────────────

# ── Meta ─────────────────────────────────────────────────────
# Los pasa Julián. Salen de la app "CRM 999 Motos" y de su Business
# Manager. Permisos concretos: SIN CONFIRMAR (riesgo R1).
META_APP_ID=2324064161428607          # app "CRM 999 Motos"
META_APP_SECRET=
META_ACCESS_TOKEN=              # ideal: token de system user (no expira)
META_API_VERSION=v26.0          # vigente al 22-sep-2026

# Login con Facebook (ADR-011). Facebook Login for Business → Configurations.
# Los permisos los fija esa configuración, no el usuario que se loguea.
META_CONFIG_ID=

# Estos IDs los descubre ./scripts/verificar-permisos-meta.sh
META_BUSINESS_ID=155769225183739
META_AD_ACCOUNT_ID=             # con el prefijo act_
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=      # SOLO servidor. Saltea RLS. Nunca al cliente.

# ── Modelos de IA ────────────────────────────────────────────
# MVP: arranca con el modelo más barato y se escala por medición.
OPENAI_API_KEY=
MODELO_ANALISTA=      # opcional. Vacío = gpt-6-luna
MODELO_ESTRATEGA=     # opcional. Vacío = gpt-6-luna
MODELO_CONTENIDISTA=  # opcional. Vacío = gpt-6-luna

# El Productor (imágenes). Sin PRESUPUESTO_MENSUAL_USD queda apagado.
GEMINI_API_KEY=
PRESUPUESTO_MENSUAL_USD=   # tope mensual en US$, p. ej. 10. Vacío = Productor apagado
MODELO_IMAGEN=             # opcional. Vacío = gemini-nano-banana-2.1

# ── Cron ─────────────────────────────────────────────────────
# Secreto propio para que el endpoint de sincronización no sea público.
CRON_SECRET=
