# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
#
#   cp env.example .env.local     ← y completar con los valores reales
#
# .env.local NUNCA se commitea ni se comparte por chat.
# (El archivo se llama env.example sin punto a propósito: los archivos
#  .env* están bloqueados por las reglas de permisos del entorno.)
# ─────────────────────────────────────────────────────────────

# ── Meta ─────────────────────────────────────────────────────
# Los pasa Julián. Salen de su app de developer (la que ya tiene
# App Review aprobado) y de su Business Manager.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=              # ideal: token de system user (no expira)
META_API_VERSION=v26.0          # vigente al 22-sep-2026

# Estos IDs los descubre ./scripts/verificar-permisos-meta.sh
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=             # con el prefijo act_
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # SOLO servidor. Saltea RLS. Nunca al cliente.

# ── Modelos de IA ────────────────────────────────────────────
# MVP: arranca con el modelo más barato y se escala por medición.
ANTHROPIC_API_KEY=
MODELO_ANALISTA=claude-haiku-4-5-20251001

# ── Cron ─────────────────────────────────────────────────────
# Secreto propio para que el endpoint de sincronización no sea público.
CRON_SECRET=
